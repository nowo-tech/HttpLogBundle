{#
  HTTP log entry (REQ-UI-003): UiKit show scaffold. Variables: page (Nowo\UiKitBundle\View\ShowPage: header with the
  back and delete actions — delete opens the UiKit confirm dialog —, breadcrumbs and the request summary section),
  entry (Nowo\HttpLogBundle\Entity\HttpLogEntry, for the payload sections).

  Payload sections (query parameters, headers, bodies) render in nowo_ui_show_after; each one is its own block
  (nowo_http_log_section_*), so an override that extends '@!NowoHttpLogBundle/admin/show.html.twig'
  (web_ui.templates.show) can replace or hide one of them.
#}
{% extends '@NowoUiKit/page/show.html.twig' %}

{% macro payload(id, title, content, truncated, bundle) %}
    <section class="{{ nowo_ui_class('section', bundle) }} {{ nowo_ui_class('card', bundle) }} nowo-http-log-payload" id="http-log-{{ id }}" data-nowo-ui-region="section"{{ nowo_ui_attrs('section', bundle) }}>
        <header class="{{ nowo_ui_class('card_header', bundle) }}">
            <h2 class="{{ nowo_ui_class('card_title', bundle) }}">
                {{- title|trans({}, 'NowoHttpLogBundle') -}}
                {%- if truncated %} <span class="{{ nowo_ui_class('badge_warning', bundle) }}">{{ 'admin.field.truncated'|trans({}, 'NowoHttpLogBundle') }}</span>{% endif -%}
            </h2>
        </header>
        <div class="{{ nowo_ui_class('card_body', bundle) }}">
            <pre class="nowo-http-log-code"><code>{{ content }}</code></pre>
        </div>
    </section>
{% endmacro %}

{% block nowo_ui_show_after %}
    {% set _b = page.bundle %}
    {% block nowo_http_log_detail_sections %}
        {% block nowo_http_log_section_query_params %}
            {% if entry.queryParams %}{{ _self.payload('query-params', 'admin.field.query_params', entry.queryParams|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')), false, _b) }}{% endif %}
        {% endblock %}
        {% block nowo_http_log_section_request_headers %}
            {% if entry.requestHeaders %}{{ _self.payload('request-headers', 'admin.field.request_headers', entry.requestHeaders|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')), false, _b) }}{% endif %}
        {% endblock %}
        {% block nowo_http_log_section_response_headers %}
            {% if entry.responseHeaders %}{{ _self.payload('response-headers', 'admin.field.response_headers', entry.responseHeaders|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')), false, _b) }}{% endif %}
        {% endblock %}
        {% block nowo_http_log_section_request_body %}
            {% if entry.requestBody %}{{ _self.payload('request-body', 'admin.field.request_body', entry.requestBody, entry.requestBodyTruncated, _b) }}{% endif %}
        {% endblock %}
        {% block nowo_http_log_section_response_body %}
            {% if entry.responseBody %}{{ _self.payload('response-body', 'admin.field.response_body', entry.responseBody, entry.responseBodyTruncated, _b) }}{% endif %}
        {% endblock %}
    {% endblock %}
{% endblock %}
