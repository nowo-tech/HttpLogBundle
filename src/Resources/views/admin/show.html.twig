{% extends nowo_http_log_layout_template|default('@NowoHttpLogBundle/layout.html.twig') %}

{% block title %}{{ 'admin.show.title'|trans({'%id%': entry.id}, 'NowoHttpLogBundle') }} — {{ parent() }}{% endblock %}

{% block nowo_ui_content %}
    <p class="nowo-ui-back mb-3">
        <a href="{{ path('nowo_http_log_admin_index') }}">&larr; {{ 'admin.action.back'|trans({}, 'NowoHttpLogBundle') }}</a>
    </p>

    <dl class="row nowo-ui-details">
        <dt class="col-sm-3">{{ 'admin.column.id'|trans({}, 'NowoHttpLogBundle') }}</dt>
        <dd class="col-sm-9">{{ entry.id }}</dd>

        <dt class="col-sm-3">{{ 'admin.field.request_id'|trans({}, 'NowoHttpLogBundle') }}</dt>
        <dd class="col-sm-9"><code>{{ entry.requestId }}</code></dd>

        <dt class="col-sm-3">{{ 'admin.column.created_at'|trans({}, 'NowoHttpLogBundle') }}</dt>
        <dd class="col-sm-9">{{ entry.createdAt|date('Y-m-d H:i:s') }}</dd>

        <dt class="col-sm-3">{{ 'admin.column.method'|trans({}, 'NowoHttpLogBundle') }}</dt>
        <dd class="col-sm-9">{{ entry.method }}</dd>

        <dt class="col-sm-3">{{ 'admin.field.url'|trans({}, 'NowoHttpLogBundle') }}</dt>
        <dd class="col-sm-9"><code>{{ entry.scheme }}://{{ entry.host }}{{ entry.path }}</code></dd>

        <dt class="col-sm-3">{{ 'admin.field.route'|trans({}, 'NowoHttpLogBundle') }}</dt>
        <dd class="col-sm-9">{{ entry.routeName }}</dd>

        <dt class="col-sm-3">{{ 'admin.column.status'|trans({}, 'NowoHttpLogBundle') }}</dt>
        <dd class="col-sm-9">{{ entry.statusCode }}</dd>

        <dt class="col-sm-3">{{ 'admin.column.duration'|trans({}, 'NowoHttpLogBundle') }}</dt>
        <dd class="col-sm-9">{{ entry.durationMs|number_format(2) }} ms</dd>

        <dt class="col-sm-3">{{ 'admin.column.client_ip'|trans({}, 'NowoHttpLogBundle') }}</dt>
        <dd class="col-sm-9">{{ entry.clientIp }}</dd>

        <dt class="col-sm-3">{{ 'admin.field.user'|trans({}, 'NowoHttpLogBundle') }}</dt>
        <dd class="col-sm-9">{{ entry.userIdentifier }}</dd>

        <dt class="col-sm-3">{{ 'admin.field.content_type'|trans({}, 'NowoHttpLogBundle') }}</dt>
        <dd class="col-sm-9">{{ entry.contentType }} ({{ entry.bodyContentType }})</dd>
    </dl>

    {% if entry.queryParams %}
        <h2 class="h5 nowo-ui-section-title">{{ 'admin.field.query_params'|trans({}, 'NowoHttpLogBundle') }}</h2>
        <pre class="nowo-ui-code bg-light p-3">{{ entry.queryParams|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    {% endif %}

    {% if entry.requestHeaders %}
        <h2 class="h5 nowo-ui-section-title">{{ 'admin.field.request_headers'|trans({}, 'NowoHttpLogBundle') }}</h2>
        <pre class="nowo-ui-code bg-light p-3">{{ entry.requestHeaders|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    {% endif %}

    {% if entry.responseHeaders %}
        <h2 class="h5 nowo-ui-section-title">{{ 'admin.field.response_headers'|trans({}, 'NowoHttpLogBundle') }}</h2>
        <pre class="nowo-ui-code bg-light p-3">{{ entry.responseHeaders|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    {% endif %}

    {% if entry.requestBody %}
        <h2 class="h5 nowo-ui-section-title">{{ 'admin.field.request_body'|trans({}, 'NowoHttpLogBundle') }}{% if entry.requestBodyTruncated %} ({{ 'admin.field.truncated'|trans({}, 'NowoHttpLogBundle') }}){% endif %}</h2>
        <pre class="nowo-ui-code bg-light p-3">{{ entry.requestBody }}</pre>
    {% endif %}

    {% if entry.responseBody %}
        <h2 class="h5 nowo-ui-section-title">{{ 'admin.field.response_body'|trans({}, 'NowoHttpLogBundle') }}{% if entry.responseBodyTruncated %} ({{ 'admin.field.truncated'|trans({}, 'NowoHttpLogBundle') }}){% endif %}</h2>
        <pre class="nowo-ui-code bg-light p-3">{{ entry.responseBody }}</pre>
    {% endif %}

    <form method="post" action="{{ path('nowo_http_log_admin_delete', {id: entry.id}) }}" class="mt-4"
          onsubmit="return confirm('{{ 'admin.delete.confirm'|trans({}, 'NowoHttpLogBundle')|e('js') }}');">
        <input type="hidden" name="_token" value="{{ csrf_token('http_log_delete') }}">
        <button type="submit" class="btn btn-danger nowo-ui-btn-delete">{{ 'admin.action.delete'|trans({}, 'NowoHttpLogBundle') }}</button>
    </form>
{% endblock %}
