{#
  DEPRECATED since 1.8 (removed in 2.0) — BC hook for hosts that set web_ui.templates.filter to a template extending
  '@!NowoHttpLogBundle/admin/_filter.html.twig'. That setting is bridged to the UiKit theme partial
  nowo_ui_kit.theme.bundles.NowoHttpLogBundle.partials.list_filters, so this file is included by the list scaffold
  with its `list_filters` context (page, region, bundle, header_actions). New code: configure the filter row through
  ListPage::filterFields / the theme (filters, filters_field, filters_actions slots) or override the
  nowo_ui_list_filters block of admin/index.html.twig.

  Blocks kept from 1.x:
    - nowo_http_log_filter_panel: the whole filter region (default: UiKit's list_filters partial)
    - nowo_http_log_filter_fields / nowo_http_log_filter_actions: when an override defines either, the form renders
      with the UiKit filter slots, the override's fields (remaining fields through form_end) and actions (default:
      the apply button). `filterForm` is page.filters.
#}
{% set filterForm = page.filters %}
{% set _b = bundle|default(page.bundle) %}
{% block nowo_http_log_filter_panel %}
    {% if block('nowo_http_log_filter_fields') is defined or block('nowo_http_log_filter_actions') is defined %}
        {{ form_start(filterForm, {attr: {class: nowo_ui_class('filters', _b), role: 'search', 'data-nowo-ui-filters': '', 'data-nowo-ui-region': region|default('filters')}}) }}
            {% if block('nowo_http_log_filter_fields') is defined %}{{ block('nowo_http_log_filter_fields') }}{% endif %}
            <div class="{{ nowo_ui_class('filters_actions', _b) }}"{{ nowo_ui_attrs('filters_actions', _b) }}>
                {% if block('nowo_http_log_filter_actions') is defined %}
                    {{ block('nowo_http_log_filter_actions') }}
                {% else %}
                    <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }} nowo-ui-filters__submit">{{ 'admin.action.filter'|trans({}, 'NowoHttpLogBundle') }}</button>
                {% endif %}
            </div>
        {{ form_end(filterForm) }}
    {% else %}
        {{ include(nowo_ui_partial('list_filters'), {page: page, region: region|default('filters'), bundle: _b, header_actions: header_actions|default([])}, false) }}
    {% endif %}
{% endblock %}
