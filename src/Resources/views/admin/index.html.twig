{% extends '@NowoHttpLogBundle/admin/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_http_log_css_framework|default('bootstrap5') %}

{% block title %}{{ 'admin.index.title'|trans({}, 'NowoHttpLogBundle') }} — {{ parent() }}{% endblock %}

{% block nowo_ui_content %}
    {{ include('@NowoHttpLogBundle/admin/_filter.html.twig') }}

    <div class="nowo-ui-toolbar d-flex justify-content-between align-items-center mb-3">
        <p class="nowo-ui-summary mb-0">{{ 'admin.index.total'|trans({'%count%': total}, 'NowoHttpLogBundle') }}</p>
        <div class="nowo-ui-actions">
            {{ form_start(exportCsvForm, {attr: {class: 'd-inline'}}) }}
                {{ form_rest(exportCsvForm) }}
                <button type="submit" class="{{ ui.btn('secondary', 'sm', _css_fw) }} nowo-ui-btn-export">{{ 'admin.action.export_csv'|trans({}, 'NowoHttpLogBundle') }}</button>
            {{ form_end(exportCsvForm, {render_rest: false}) }}

            {{ form_start(exportJsonForm, {attr: {class: 'd-inline ms-1'}}) }}
                {{ form_rest(exportJsonForm) }}
                <button type="submit" class="{{ ui.btn('secondary', 'sm', _css_fw) }} nowo-ui-btn-export">{{ 'admin.action.export_json'|trans({}, 'NowoHttpLogBundle') }}</button>
            {{ form_end(exportJsonForm, {render_rest: false}) }}

            {{ form_start(purgeForm, {
                attr: {
                    class: 'd-inline ms-1',
                    onsubmit: "return confirm('#{'admin.purge.confirm'|trans({}, 'NowoHttpLogBundle')|e('js')}');",
                },
            }) }}
                {{ form_rest(purgeForm) }}
                <button type="submit" class="{{ ui.btn('danger', 'sm', _css_fw) }} nowo-ui-btn-purge">{{ 'admin.action.purge'|trans({}, 'NowoHttpLogBundle') }}</button>
            {{ form_end(purgeForm, {render_rest: false}) }}
        </div>
    </div>

    <div class="nowo-ui-table-wrap table-responsive">
        <table class="table table-striped table-sm nowo-ui-table">
            <thead>
                <tr>
                    <th>{{ 'admin.column.id'|trans({}, 'NowoHttpLogBundle') }}</th>
                    <th>{{ 'admin.column.created_at'|trans({}, 'NowoHttpLogBundle') }}</th>
                    <th>{{ 'admin.column.method'|trans({}, 'NowoHttpLogBundle') }}</th>
                    <th>{{ 'admin.column.path'|trans({}, 'NowoHttpLogBundle') }}</th>
                    <th>{{ 'admin.column.status'|trans({}, 'NowoHttpLogBundle') }}</th>
                    <th>{{ 'admin.column.duration'|trans({}, 'NowoHttpLogBundle') }}</th>
                    <th>{{ 'admin.column.client_ip'|trans({}, 'NowoHttpLogBundle') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                    <tr>
                        <td>{{ entry.id }}</td>
                        <td>{{ entry.createdAt|date('Y-m-d H:i:s') }}</td>
                        <td><span class="badge bg-secondary">{{ entry.method }}</span></td>
                        <td class="text-truncate" style="max-width: 20rem;">{{ entry.path }}</td>
                        <td>{{ entry.statusCode }}</td>
                        <td>{{ entry.durationMs|number_format(1) }} ms</td>
                        <td>{{ entry.clientIp }}</td>
                        <td>
                            <div class="{{ ui.row_actions(_css_fw) }}">
                                <a href="{{ path('nowo_http_log_admin_show', {id: entry.id}) }}" class="{{ ui.btn('secondary', 'sm', _css_fw) }} nowo-ui-btn-view">
                                    {{ 'admin.action.view'|trans({}, 'NowoHttpLogBundle') }}
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-muted">{{ 'admin.index.empty'|trans({}, 'NowoHttpLogBundle') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if total > pageSize %}
        {% set totalPages = (total / pageSize)|round(0, 'ceil') %}
        <nav class="nowo-ui-pagination mt-3">
            <ul class="pagination">
                {% if page > 1 %}
                    <li class="page-item"><a class="page-link" href="{{ path('nowo_http_log_admin_index', criteria|merge({page: page - 1})) }}">&laquo;</a></li>
                {% endif %}
                <li class="page-item disabled"><span class="page-link">{{ 'admin.pagination.page'|trans({'%page%': page, '%total%': totalPages}, 'NowoHttpLogBundle') }}</span></li>
                {% if page < totalPages %}
                    <li class="page-item"><a class="page-link" href="{{ path('nowo_http_log_admin_index', criteria|merge({page: page + 1})) }}">&raquo;</a></li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
{% endblock %}
