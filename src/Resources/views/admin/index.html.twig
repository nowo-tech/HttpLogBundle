{#
  HTTP log list (REQ-UI-003): UiKit list scaffold. Variable: page (Nowo\UiKitBundle\View\ListPage), criteria (active
  filter criteria). Header actions (export CSV / JSON, purge with the UiKit confirm dialog), filters, table frame,
  row actions, pagination and empty state come from the scaffold; this template fills only the row cells.

  Override: a template that extends '@!NowoHttpLogBundle/admin/index.html.twig' (web_ui.templates.index) and overrides
  nowo_ui_list_row (or another scaffold data block). Restyle through nowo_ui_kit.theme (slots), never here.
#}
{% extends '@NowoUiKit/page/list.html.twig' %}

{% block nowo_ui_list_row %}
    {%- set _b = page.bundle -%}
    {%- set _cell = nowo_ui_class('table_cell', _b) -%}
    {%- set _status = row.statusCode|default(0) -%}
    {%- set _status_slot = _status >= 500 ? 'badge_danger' : (_status >= 400 ? 'badge_warning' : (_status >= 300 ? 'badge_info' : 'badge_success')) -%}
    <td class="{{ _cell }} nowo-ui-cell--start" data-label="{{ 'admin.column.id'|trans({}, 'NowoHttpLogBundle') }}">
        <a href="{{ path('nowo_http_log_admin_show', {id: row.id}) }}">{{ row.id }}</a>
    </td>
    <td class="{{ _cell }} nowo-ui-cell--start" data-label="{{ 'admin.column.created_at'|trans({}, 'NowoHttpLogBundle') }}" data-nowo-ui-priority="2">
        <time datetime="{{ row.createdAt|date('c') }}">{{ row.createdAt|date('Y-m-d H:i:s') }}</time>
    </td>
    <td class="{{ _cell }} nowo-ui-cell--start" data-label="{{ 'admin.column.method'|trans({}, 'NowoHttpLogBundle') }}">
        <span class="{{ nowo_ui_class('badge_neutral', _b) }} nowo-http-log-method">{{ row.method }}</span>
    </td>
    <td class="{{ _cell }} nowo-ui-cell--start nowo-http-log-path" data-label="{{ 'admin.column.path'|trans({}, 'NowoHttpLogBundle') }}">
        <code>{{ row.path }}</code>
    </td>
    <td class="{{ _cell }} nowo-ui-cell--start" data-label="{{ 'admin.column.status'|trans({}, 'NowoHttpLogBundle') }}">
        {%- if row.statusCode is not null -%}
            <span class="{{ nowo_ui_class(_status_slot, _b) }} nowo-http-log-status">{{ row.statusCode }}</span>
        {%- else -%}
            <span class="{{ nowo_ui_class('muted', _b) }}">—</span>
        {%- endif -%}
    </td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'admin.column.duration'|trans({}, 'NowoHttpLogBundle') }}" data-nowo-ui-priority="2">
        {{ row.durationMs is null ? '—' : row.durationMs|number_format(1) ~ ' ms' }}
    </td>
    <td class="{{ _cell }}{{ row.clientIp ? '' : ' ' ~ nowo_ui_class('table_cell_muted', _b) }} nowo-ui-cell--start" data-label="{{ 'admin.column.client_ip'|trans({}, 'NowoHttpLogBundle') }}" data-nowo-ui-priority="3">
        {{ row.clientIp ?: '—' }}
    </td>
{% endblock %}
