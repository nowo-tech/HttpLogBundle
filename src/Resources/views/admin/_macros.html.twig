{# Admin chrome helpers (spec 002). Import: {% import '@NowoHttpLogBundle/admin/_macros.html.twig' as chrome %} #}

{# Renders ` class="…"` from a string or list of strings; nothing when every value is empty/null. #}
{% macro class_attr(classes) -%}
    {%- set _list = classes is iterable ? classes : [classes] -%}
    {%- set _joined = _list|filter(c => c is not null and c|trim != '')|join(' ') -%}
    {%- if _joined != '' %} class="{{ _joined }}"{% endif -%}
{%- endmacro %}

{# Renders extra HTML attributes (` name="value"` pairs) from a hash; nothing for an empty hash. #}
{% macro attrs(attributes) -%}
    {%- for _name, _value in attributes|default({}) -%}
        {%- if _value is not same as(false) and _value is not null %} {{ _name|e('html_attr') }}="{{ _value }}"{% endif -%}
    {%- endfor -%}
{%- endmacro %}
