{#
  Default list pagination (web_ui.templates.pagination).

  Context: the list page context plus a UiKit-compatible contract, so a host can point
  web_ui.templates.pagination at @NowoUiKitBundle/partials/_pagination.html.twig or its own adapter:
    - pagination: {page, per_page, total, total_pages}
    - pages, page_size, item_count, route, route_params, query (active filters as the filter form reads them: {http_log_filter: {field: value}}), nav_label, nav_trans_domain, framework
#}
{% import '@NowoHttpLogBundle/admin/_macros.html.twig' as chrome %}
{% set _ui = nowo_http_log_ui|default(constant('Nowo\\HttpLogBundle\\View\\AdminChrome::DEFAULTS')) %}
{% set _cls = _ui.css_classes %}
{% if total > pageSize %}
    {% set totalPages = (total / pageSize)|round(0, 'ceil') %}
    <nav{{ chrome.class_attr(_cls.pagination) }}>
        <ul{{ chrome.class_attr(_cls.pagination_list) }}>
            {% if page > 1 %}
                <li{{ chrome.class_attr(_cls.page_item) }}><a{{ chrome.class_attr(_cls.page_link) }} href="{{ path('nowo_http_log_admin_index', query|default({})|merge({page: page - 1})) }}">&laquo;</a></li>
            {% endif %}
            <li{{ chrome.class_attr([_cls.page_item, 'disabled']) }}><span{{ chrome.class_attr(_cls.page_link) }}>{{ 'admin.pagination.page'|trans({'%page%': page, '%total%': totalPages}, 'NowoHttpLogBundle') }}</span></li>
            {% if page < totalPages %}
                <li{{ chrome.class_attr(_cls.page_item) }}><a{{ chrome.class_attr(_cls.page_link) }} href="{{ path('nowo_http_log_admin_index', query|default({})|merge({page: page + 1})) }}">&raquo;</a></li>
            {% endif %}
        </ul>
    </nav>
{% endif %}
