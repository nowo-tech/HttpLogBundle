{% trans_default_domain 'NowoHttpLogBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_http_log_css_framework|default('bootstrap5') %}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}" class="nowo-ui-html nowo-ui--{{ _css_fw }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'admin.title'|trans({}, 'NowoHttpLogBundle') }}{% endblock %}</title>
    {# Demo root layout: no parent() (full HTML). Bundle pages stack via admin/base.html.twig. #}
    {% block stylesheets %}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    {% endblock %}
</head>
<body class="nowo-ui-body">
    <div class="nowo-ui-container container py-4">
        <header class="nowo-ui-header mb-4">
            <h1 class="nowo-ui-title">{% block page_title %}{{ 'admin.title'|trans({}, 'NowoHttpLogBundle') }}{% endblock %}</h1>
        </header>
        <main class="nowo-ui-main">
            {% block nowo_ui_flashes %}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="{{ ui.flash(label == 'error' ? 'error' : label, _css_fw) }}" role="alert">{{ message }}</div>
                    {% endfor %}
                {% endfor %}
            {% endblock %}
            {% block nowo_ui_content %}{% endblock %}
        </main>
    </div>
    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    {% endblock %}
</body>
</html>
