{# Host root layout (like Beacon _kit_admin_layout): renders a header-actions slot filled by the bridge. #}
<!DOCTYPE html>
<html>
<head><title>{% block title %}Host{% endblock %}</title>{% block stylesheets %}{% endblock %}</head>
<body>
<header class="host-header">{{ host_header_actions|default('') }}</header>
<main>{% block body %}{% endblock %}</main>
{% block javascripts %}{% endblock %}
</body>
</html>
