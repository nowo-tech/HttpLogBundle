<p class="host-pagination" data-page="{{ pagination.page }}" data-pages="{{ pages }}" data-total-pages="{{ pagination.total_pages }}" data-per-page="{{ pagination.per_page }}" data-route="{{ route }}" data-query="{{ query|json_encode }}" data-items="{{ item_count }}" data-nav="{{ nav_label|trans({}, nav_trans_domain) }}"></p>
