{% extends 'base.html.twig' %}

{% block title %}Http Log Demo{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h3 mb-3">HTTP request / response logging</h1>
                <p class="text-muted">
                    Each page load and API call is captured by <strong>HttpLogBundle</strong>.
                    Open the admin UI to browse, filter, export, or purge entries.
                </p>
                <p class="small text-muted">Page generated at {{ generatedAt }}.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" href="{{ path('demo_home') }}">Reload (capture another log)</a>
                    <a class="btn btn-outline-secondary" href="{{ path('demo_api_ping') }}">GET /api/ping (JSON)</a>
                    <a class="btn btn-success" href="/admin/http-log">Admin UI (HTTP Basic: admin / admin)</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
