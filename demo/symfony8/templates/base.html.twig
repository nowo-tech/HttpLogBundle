<!DOCTYPE html>
<html lang="en"{% block html_attributes %}{% endblock %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Http Log Demo{% endblock %}</title>
    {# Demo host: Bootstrap from a CDN in the `base` cascade layer, below UiKit's nowo-ui layer (UiKit PAGE_CONTRACT "Cascade layers"). #}
    <style>@layer theme, base, nowo-ui, components, utilities; @import url("https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css") layer(base);</style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="{{ path('demo_home') }}">Http Log Bundle · Symfony 8</a>
        <a class="nav-link text-white-50" href="{{ path('nowo_http_log_admin_index') }}">Admin UI</a>
    </div>
</nav>
<main class="container pb-5">
    {% block body %}{% endblock %}
</main>
{% block javascripts %}{% endblock %}
</body>
</html>
