    nav: [
        {label: 'Overview', route: 'demo_home', section: 'Demo'},
        {label: 'Admin UI', route: 'nowo_http_log_admin_index', active: ['nowo_http_log_admin_*'], section: 'Http Log admin'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}Http Log Demo{% endblock %} — Symfony 8{% endblock %}
