{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). The masthead lists the demo pages with the active item; the HttpLog admin
    pages (nowo_ui_kit.layouts.admin, REQ-UI-003) render inside the same layout. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Http Log Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">Http Log Bundle · Symfony 8</a>
        <nav class="nowo-ui-menu" aria-label="Demo">
            {% for item in [{route: 'demo_home', label: 'Overview'}, {route: 'demo_api_ping', label: 'API ping'}, {route: 'nowo_http_log_admin_index', label: 'Admin UI'}] %}
                <a class="nowo-ui-link" href="{{ path(item.route) }}"{% if _route == item.route %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {% endfor %}
        </nav>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
